# Public -- safe to ship in the browser bundle, governed entirely by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://wjxvingpfbfvkfqhrguj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_ -- it bypasses RLS and must
# never reach a browser bundle. Used read-only by src/lib/data.ts (through
# src/lib/supabase/service.ts) for the refunds list, Razorpay payment details
# and people's phone/email. Without it those three show a note instead.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. Copy it from Supabase Vault
# (secret API_GATEWAY_SECRET, created by migration 083). Once the gateway-only
# lockdown is on, the database refuses this panel's queries without it.
API_GATEWAY_SECRET=

# Who may open the panel, on top of the admin role in the database (server only).
# Sign-in is Google or @username + password; there is no text-message sign-in.
# ADMIN_EMAIL is the admin's Google account. ADMIN_PHONE only matters if the
# admin account was originally created with a mobile number: that account may
# then sign in with its @username and password.
ADMIN_EMAIL=
ADMIN_PHONE=

# Admin session limits (server only). Signed out after ADMIN_IDLE_MINUTES with
# no activity (default 30), and ADMIN_SESSION_HOURS after signing in however
# busy (default 12). ADMIN_SESSION_SECRET signs the idle-time cookie: any long
# random string (e.g. `openssl rand -hex 32`). Without it the service role key
# is used to sign; with neither, only the 12-hour limit applies.
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_SECRET=
